# Local PostgreSQL username for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose; replace in real deployments.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Host port for backend service.
BACKEND_PORT=8080

# Host port for frontend service.
FRONTEND_PORT=3000

# Browser-visible backend base URL for frontend builds. Do not include /api.
NEXT_PUBLIC_API_URL=http://localhost:8080
